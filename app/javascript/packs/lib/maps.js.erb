//'8fb98b426566d683'
const MARKER_WIDTH = 37;

// Load image paths with erb templating
<% helpers = ActionController::Base.helpers %>
const currentLocationImage = "<%= helpers.image_path('marker-icon.png') %>";
const circleMarkerImage = "<%= helpers.image_path('marker-circle.png') %>";
const showMarkerImage = "<%= helpers.image_path('show-icon.png') %>";

let map;
let lastOpenedInfoWindow;
let markers = [];

function initMap(x, y, z, image, draggable, callback){
  // Default to center of the US if latitude or longitude is undefined
  if (!x || !y) {
    x = 39.8283;
    y = -98.5795;
    z = 4;
  }
  image = typeof image !== 'undefined' ? image : currentLocationImage;

  // Draggable defaults to false
  draggable = draggable || false;

  // Init map (include mapId if you have one, e.g., mapId: 'YOUR_VALID_MAP_ID')
  var mapOptions = {
    zoom: parseInt(z, 10) || 3,
    center: new google.maps.LatLng(x, y),
    mapTypeControl: false, // Removes Satellite and Map toggle
    streetViewControl: false,
    mapId: '8fb98b426566d683',
  };
  if(y == '-98.5556199'){
    mapOptions.zoom = 4;
  }

  map = new google.maps.Map(document.getElementById('mapArea'), mapOptions);

  google.maps.event.addListenerOnce(map, 'idle', function() {
    $('#mapArea').addClass('loaded');
  });

  // Set marker at current location using a standard marker
  var myLatLng = new google.maps.LatLng(x, y);
  var currentLocation = new google.maps.Marker({
    title: "Current Location",
    position: myLatLng,
    draggable: draggable,
    map: map,
    icon: image
  });

  currentLocation.addListener("dragend", callback);
}

function getPoint(string, callback){
  // Google Geocoding API
  var url = "http://maps.googleapis.com/maps/api/geocode/json?address=" + string.replace(" ", "+");
  $.get(url, function(data) {
    if(data && data.results){
      if(data.results.length > 0){
        callback(data.results[0].geometry.location);
      }
    }
  });
}

function placeMarker(lat, lng, content, number){
  // Create container for the marker element
  const markerDiv = document.createElement('div');
  markerDiv.style.position = 'relative';
  markerDiv.style.width = MARKER_WIDTH + 'px';
  markerDiv.style.height = MARKER_WIDTH + 'px';

  // Create an image element for the marker icon
  const markerImg = document.createElement('img');
  markerImg.src = circleMarkerImage;
  markerImg.style.width = '100%';
  markerImg.style.height = '100%';
  markerDiv.appendChild(markerImg);

  // Create a label element for the number
  const markerLabel = document.createElement('div');
  markerLabel.textContent = number.toString();
  markerLabel.style.position = 'absolute';
  markerLabel.style.top = '50%';
  markerLabel.style.left = '50%';
  markerLabel.style.transform = 'translate(-50%, -50%)';
  markerLabel.style.color = 'white';
  markerLabel.style.fontWeight = 'bold';
  markerDiv.appendChild(markerLabel);

  // Create the advanced marker using AdvancedMarkerElement.
  // Ensure your API script includes v=beta and libraries=marker.
  const advancedMarker = new google.maps.marker.AdvancedMarkerElement({
    map: map,
    position: {lat: lat, lng: lng},
    content: markerDiv
  });

  // Register a click event on the AdvancedMarkerElement instance for improved accessibility.
  google.maps.event.addListener(advancedMarker, 'click', function() {
    closeLastOpenedInfoWindow();
    const infoWindow = new google.maps.InfoWindow({
      content: content,
      position: advancedMarker.position
    });
    infoWindow.open(map);
    lastOpenedInfoWindow = infoWindow;
  });

  // Optionally, you can still listen on map clicks to close open info windows.
  map.addListener('click', function() {
    if(lastOpenedInfoWindow) {
      lastOpenedInfoWindow.close();
    }
  });

  // Store marker content for clustering purposes.
  advancedMarker.myContent = content;

  markers.push(advancedMarker);
}

function closeLastOpenedInfoWindow() {
  if (lastOpenedInfoWindow) {
    lastOpenedInfoWindow.close();
  }
}

function generateContent(data){
  var item = $(".listItem[data-id=" + data.id + "]");
  var container = $("<div class='markerPopup' />");
  container.append(item.clone());
  return container[0].outerHTML;
}

function setPoint(data, number){
  if(data.latitude && data.longitude){
    placeMarker(data.latitude, data.longitude, generateContent(data), number);
  }
}

/*
* Geocoding
*/

var currentLocationText = "Current Location";

function searchLocation(search){
  if (search == currentLocationText) {
    searchCurrent();
    return;
  }
  if(search == ""){
    handleSearchResults(37.7577, -122.4376);
    return;
  }
  var geocoder = new google.maps.Geocoder();
  geocoder.geocode({
    'address': search
  }, function (results, status) {
    if (status == google.maps.GeocoderStatus.OK) {
      handleSearchResults(results[0].geometry.location.lat(), results[0].geometry.location.lng());
    } else {
      emitError("Geocoder failed due to: " + status);
    }
  });
}

function handleSearchResults(lat, lng){
  $("#lat").val(lat);
  $("#long").val(lng);
  $(".search").find("form").submit();
}

function searchCurrent() {
  var button = $('.currentLocationButton');
  if (button.is('currentLocationButtonLocating')) {
    return false;
  }
  button.addClass('currentLocationButtonLocating');
  var location = locator.get();
  location.always(function() {
    button.removeClass('currentLocationButtonLocating');
  });
  location.then(function gotCoordinates(coords) {
    $("#search").val(currentLocationText);
    handleSearchResults(coords.latitude, coords.longitude);
  }, emitError);
}

/*
 * Error Handling
 */

function emitError(error){
  console.error(error.stack || error);
  alert(error.message || error);
}

function guessPosition (coords, callback) {
  var geocoder = new google.maps.Geocoder();
  geocoder.geocode({
    'location': new google.maps.LatLng(coords.latitude, coords.longitude)
  }, function (results, status) {
    if (status == google.maps.GeocoderStatus.OK) {
      callback(results);
    } else {
      emitError("Geocoder failed due to: " + status);
    }
  });
}

export const Maps = {
  reloadMap: (map) => {
    initMap(map.dataset.latitude, map.dataset.longitude, map.dataset.zoom, showMarkerImage);
  },
  reloadDraggable: (map, callback) => {
    initMap(map.dataset.latitude, map.dataset.longitude, map.dataset.zoom, showMarkerImage, true, callback);
  },
  loadMapWithPoints: (lat, long, zoom, points) => {
    initMap(lat, long, zoom);
    for (const [i, point] of points.entries()) {
      setPoint(point, i + 1);
    }
    // Create the MarkerClusterer instance using the UMD global markerClusterer
    const clusterer = new markerClusterer.MarkerClusterer(map, markers, {
      imagePath: 'https://developers.google.com/maps/documentation/javascript/examples/markerClusterer/m'
    });
    // When a cluster is clicked, aggregate the content from all markers in the cluster and display it in an info window.
    google.maps.event.addListener(clusterer, 'clusterclick', function(cluster) {
      const markersInCluster = cluster.getMarkers();
      let aggregatedContent = '<ul>';
      markersInCluster.forEach(marker => {
        aggregatedContent += `<li>${marker.myContent}</li>`;
      });
      aggregatedContent += '</ul>';
      const infoWindow = new google.maps.InfoWindow({
        content: aggregatedContent,
        position: cluster.getCenter()
      });
      infoWindow.open(map);
    });
  },
  loadShowcaseMapWithPoints: (lat, long, zoom, markerImage) => {
    initMap(lat, long, zoom, markerImage);
    $.get('/experiences' + window.location.search, {}, (points) => {
      for (const [i, point] of points.entries()) {
        setPoint(point, i + 1);
      }
      const clusterer = new markerClusterer.MarkerClusterer(map, markers, {
        imagePath: 'https://developers.google.com/maps/documentation/javascript/examples/markerClusterer/m'
      });
      google.maps.event.addListener(clusterer, 'clusterclick', function(cluster) {
        const markersInCluster = cluster.getMarkers();
        let aggregatedContent = '<ul>';
        markersInCluster.forEach(marker => {
          aggregatedContent += `<li>${marker.myContent}</li>`;
        });
        aggregatedContent += '</ul>';
        const infoWindow = new google.maps.InfoWindow({
          content: aggregatedContent,
          position: cluster.getCenter()
        });
        infoWindow.open(map);
      });
    }, 'json');
  }
}

$(function(){
  let mapArea = $('#mapArea');
  if(mapArea.length > 0) {
    if(mapArea.hasClass('showcase')){
      Maps.loadShowcaseMapWithPoints(mapArea.data('latitude'), mapArea.data('longitude'), mapArea.data('zoom'), showMarkerImage);
    } else {
      initMap(mapArea.data('latitude'), mapArea.data('longitude'), mapArea.data('zoom'), showMarkerImage);
    }
  }
});